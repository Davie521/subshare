# Copy to .env.local and fill in.

# Postgres connection string.
# Local dev (hybrid mode): matches docker-compose.yml's postgres service.
DATABASE_URL=postgres://subshare:subshare@localhost:5432/subshare

# HMAC key for signed session cookies. REQUIRED in production.
# Must be a random value of at least 32 chars. Generate with:
#   openssl rand -base64 48
# A dev-only fallback is used when NODE_ENV=development and this is unset.
# Leaving this blank or using a placeholder in any other environment will
# cause the app to refuse to start.
SESSION_SECRET=

# Bearer token required by POST /api/cron/billing. REQUIRED for cron to work.
# Must be a random value of at least 32 chars. Generate with:
#   openssl rand -hex 32
CRON_SECRET=

# Set PGSSLMODE=disable to opt out of Postgres TLS (local Docker dev only).
# In production, leave unset so the driver negotiates TLS.
# PGSSLMODE=disable
