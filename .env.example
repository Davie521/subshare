# Copy to .env.local and fill in.

# Postgres connection string.
# Local dev (hybrid mode): matches docker-compose.yml's postgres service.
DATABASE_URL=postgres://subshare:subshare@localhost:5432/subshare

# HMAC key for signed session cookies. Must be at least 32 chars.
# Generate with: openssl rand -base64 48
SESSION_SECRET=change-me-to-a-random-32-char-string

# Bearer token required by POST /api/cron/billing.
CRON_SECRET=change-me
