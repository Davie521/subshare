# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
# auto-regenerated by `next dev` / `next build`; path churns between modes
next-env.d.ts

# production
/build

# misc
.DS_Store
*.pem

# editor / IDE
.vscode/
.idea/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (only .env.example is tracked)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo


# build-time generated icons
/public/icons


# playwright-mcp artifacts (local dev only)
.playwright-mcp/

# external Claude Code worktrees / session artefacts
/.claude/worktrees
/.claude/*.log
/.claude/scheduled_tasks.lock
ui-review-*.png
